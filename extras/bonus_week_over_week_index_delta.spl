index=_internal sourcetype=splunkd source=*metrics.log group=per_index_thruput earliest=-60d@d latest=@d
| fields _time series kb
| where isnotnull(series)
| where NOT match(series, "^_") AND series!="history" AND series!="summary"
| eval week=strftime(_time,"%Y-%U")
| stats sum(kb) as kb by week series
| sort 0 series week
| streamstats current=f window=1 last(kb) as prev_kb by series
| where isnotnull(prev_kb)
| eval this_week_GB=round(kb/1024/1024,2)
| eval delta_GB=round((kb-prev_kb)/1024/1024,2)
| eval delta_pct=if(prev_kb>0, round((kb-prev_kb)/prev_kb*100,1), null())
| rename series as index
| sort 20 -delta_GB
| table index this_week_GB delta_GB delta_pct week
