index=_internal source=*search.log earliest=-7d@d latest=@d
| fields _time source user search_id _raw
| rex field=source "/dispatch/(?<dispatch_id>[^/]+)/search\\.log"
| eval search_id=coalesce(search_id,dispatch_id)
| rex field=search_id "^(?<sid_user>[^_]+)_"
| eval user=coalesce(user,sid_user,"unknown")
| where isnotnull(search_id)
| stats dc(search_id) as search_jobs count as search_log_events
        min(_time) as first_seen max(_time) as last_seen by user
| eval first_seen=strftime(first_seen,"%Y-%m-%d %H:%M")
| eval last_seen=strftime(last_seen,"%Y-%m-%d %H:%M")
| sort 20 -search_jobs
| table user search_jobs search_log_events first_seen last_seen
