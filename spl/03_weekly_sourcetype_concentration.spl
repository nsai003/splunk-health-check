index=_internal source=*metrics.log group=per_sourcetype_thruput earliest=-7d@d latest=@d
| fields _time series kb
| stats sum(kb) as kb by series
| eventstats sum(kb) as total_kb
| eval GB=round(kb/1024/1024,2)
| eval pct_of_total=round(kb/total_kb*100,1)
| rename series as sourcetype
| sort -GB
| head 20
| table sourcetype GB pct_of_total

