index=_internal sourcetype=splunkd source=*metrics.log group=per_index_thruput earliest=-7d@d latest=@d
| fields series kb
| where isnotnull(series)
| where NOT match(series, "^_") AND series!="history" AND series!="summary"
| stats sum(kb) as kb by series
| eventstats sum(kb) as total_kb
| eval GB=round(kb/1024/1024,2)
| eval pct_of_total=if(total_kb>0, round(kb/total_kb*100,1), null())
| sort 20 -GB
| streamstats count as rank
| eval data_stream="Data Stream ".rank
| table data_stream GB pct_of_total
