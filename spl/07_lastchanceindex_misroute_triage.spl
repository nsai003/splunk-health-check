index=_internal sourcetype=splunkd source=*splunkd.log earliest=-7d@d latest=@d
    ("Received event for unconfigured/disabled/deleted index" OR "Redirected event for unconfigured/disabled/deleted index")
| fields _time host source sourcetype _raw
| where match(_raw, "(?i)(Received|Redirected) event for unconfigured/disabled/deleted index=")
| rex field=_raw "index=(?:\"|')?(?<missing_index>[^\"'\\s,]+)"
| rex field=_raw "host=\"host::(?<source_host>[^\"]+)\""
| rex field=_raw "source=\"source::(?<original_source>[^\"]+)\""
| rex field=_raw "sourcetype=\"sourcetype::(?<source_type>[^\"]+)\""
| eval route_message=case(match(_raw,"(?i)into the LastChanceIndex"),"Redirected to LastChanceIndex", match(_raw,"(?i)Received event for unconfigured/disabled/deleted index"),"Missing or invalid index", true(),"Unclassified")
| eval missing_index=trim(coalesce(missing_index,""))
| eval source_host=trim(coalesce(source_host,host,""))
| eval original_source=trim(coalesce(original_source,""))
| eval source_type=trim(coalesce(source_type,""))
| eval missing_index=if(missing_index="" OR match(missing_index,"(?i)^\\[?null(,null)*\\]?$"),"unspecified",missing_index)
| eval source_host=if(source_host="" OR match(source_host,"(?i)^\\[?null(,null)*\\]?$"),"unknown",source_host)
| eval original_source=if(original_source="" OR match(original_source,"(?i)^\\[?null(,null)*\\]?$"),"unknown",original_source)
| eval source_type=if(source_type="" OR match(source_type,"(?i)^\\[?null(,null)*\\]?$"),"unknown",source_type)
| addinfo
| eval window_days=max(round((info_max_time-info_min_time)/86400,2),1)
| stats count as event_count values(source_type) as sourcetypes
        min(_time) as first_seen max(_time) as last_seen
        by route_message missing_index source_host original_source window_days
| eval events_per_day=round(event_count/window_days,2)
| eval first_seen=strftime(first_seen,"%Y-%m-%d %H:%M")
| eval last_seen=strftime(last_seen,"%Y-%m-%d %H:%M")
| sort missing_index -event_count
| table route_message missing_index source_host original_source sourcetypes event_count events_per_day first_seen last_seen
