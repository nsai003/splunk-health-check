index=_internal source=*metrics.log group=per_index_thruput
    series!=_* series!=history series!=summary earliest=-60d@d latest=@d
| fields _time series kb
| eval week=strftime(_time,"%Y-%U")
| stats sum(kb) as kb by week series
| sort 0 series week
| streamstats current=f window=1 last(kb) as prev_kb by series
| where isnotnull(prev_kb)
| eval this_week_GB=round(kb/1024/1024,2)
| eval delta_GB=round((kb-prev_kb)/1024/1024,2)
| rename series as index
| sort -delta_GB
| head 20
| table index this_week_GB delta_GB week

