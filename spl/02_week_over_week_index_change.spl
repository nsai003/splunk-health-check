index=_internal sourcetype=splunkd source=*metrics.log group=per_index_thruput earliest=-14d@d latest=@d
| fields _time series kb
| where isnotnull(series)
| where NOT match(series, "^_") AND series!="history" AND series!="summary"
| eval period=if(_time>=relative_time(now(),"-7d@d"),"current_week","previous_week")
| stats sum(kb) as kb by series period
| eval GB=round(kb/1024/1024,2)
| xyseries series period GB
| fillnull value=0 current_week previous_week
| eval delta_GB=round(current_week-previous_week,2)
| eval delta_pct=case(previous_week>0, round((current_week-previous_week)/previous_week*100,1), current_week>0, null(), true(), 0)
| rename series as index
| sort 20 -delta_GB
| table index current_week previous_week delta_GB delta_pct
